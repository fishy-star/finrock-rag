# Copy this file to .env and fill in real values. .env is gitignored.

# Required only for POST /rag/query (full synthesized answers).
# Retrieval itself (/rag/check) works with zero API keys.
ANTHROPIC_API_KEY=

# Optional overrides — defaults shown are what config.py falls back to.
CHROMA_DIR=./db/chroma_store
DUCKDB_PATH=./db/reference.duckdb
RETRIEVAL_TOP_K=5
